<Window x:Class="WideLong.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/WideLong.ico" Title="WideLong · local data preparation" Width="1480" Height="920" MinWidth="1080" MinHeight="740" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#E3DCEB" BorderThickness="0,0,0,1" Padding="24,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/WideLongLogo.png" Width="58" Height="58" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" AutomationProperties.Name="WideLong logo"/><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock FontSize="26" FontWeight="SemiBold"><Run Text="Wide" Foreground="{StaticResource Accent}"/><Run Text="Long" Foreground="#9B6FD6"/></TextBlock><Border Background="#EEE7F6" CornerRadius="4" Padding="8,4" Margin="14,4,0,0" VerticalAlignment="Center"><TextBlock Text="LOCAL ONLY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/></Border><TextBlock x:Name="VersionLabel" Text="PROTOTYPE" FontSize="10" Foreground="#80738C" Margin="12,12,0,0"/></StackPanel><TextBlock Text="Bring your files together. Make the dataset you need." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Examples…" Click="Demo_Click"/><Button Content="Recipe ▾" Click="Recipe_Click" ToolTip="Save this session's settings and steps (no data) or reopen them on the original files"/><Button Content="+ Import CSV" Click="Import_Click"/><Button Content="Cleaning code…" Click="Code_Click" x:Name="CodeButton"/><Button Content="Export data…" Style="{StaticResource Primary}" Click="Export_Click" x:Name="ExportButton"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="278"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="#E3DCEB" BorderThickness="0,0,1,0">
        <DockPanel Margin="17,18,13,12">
          <StackPanel DockPanel.Dock="Top"><TextBlock Text="KEEP VARIABLES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="Choose columns from each source file." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,12"/><TextBox x:Name="VariableSearch" ToolTip="Find a variable or source file" TextChanged="VariableSearch_Changed" Margin="0,0,0,5"/><TextBlock Text="Find variables" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/></StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><Separator Background="#E3DCEB"/><TextBlock Text="Your data stays private and remains on this computer only" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,12,0,4"/><TextBlock Text="This app does not send or save it" FontSize="11" Foreground="{StaticResource Muted}"/><Button Content="Clear session" Style="{StaticResource Quiet}" Click="Clear_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SourcesPanel"/></ScrollViewer>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="22,18,22,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your dataset, your order" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Click column names to sort. Drag any column to move it. Right-click for edits. Double-click a cell to edit its value." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,16"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="Review matching…" Click="MatchingReview_Click" Style="{StaticResource Quiet}"/><Button Content="Map columns…" Click="MappingEditor_Click" Style="{StaticResource Quiet}"/><Button x:Name="HistoryButton" Content="History (0)" Click="History_Click" Style="{StaticResource Quiet}"/><Button Content="Undo" ToolTip="Undo the last data change (Ctrl+Z)" Click="Undo_Click" x:Name="UndoButton" Style="{StaticResource Quiet}"/><Button Content="Redo" ToolTip="Redo (Ctrl+Y)" Click="Redo_Click" x:Name="RedoButton" Style="{StaticResource Quiet}" Margin="0"/></StackPanel></Grid>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E9E2F0" CornerRadius="7" Padding="4" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><RadioButton x:Name="IdMode" Content="ID" GroupName="Layout" Tag="Person" Style="{StaticResource Mode}" Checked="Mode_Changed"/><RadioButton x:Name="TimeMode" Content="ID + time" Tag="PersonTime" GroupName="Layout" IsChecked="True" Style="{StaticResource Mode}" Checked="Mode_Changed"/><RadioButton Content="Custom variables" GroupName="Layout" Tag="Measurement" Style="{StaticResource Mode}" Checked="Mode_Changed"/><RadioButton x:Name="DyadMode" Content="Dyads" GroupName="Layout" Tag="Dyad" Style="{StaticResource Mode}" Checked="Mode_Changed" ToolTip="One row per ID + role + time for two roles, with the partner's values in *_partner columns"/><RadioButton x:Name="SourceMode" Content="Source rows" GroupName="Layout" Tag="Source" Style="{StaticResource Mode}" Checked="Mode_Changed"/></StackPanel></Border><StackPanel Grid.Column="1" x:Name="ExampleLabel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="FICTIONAL EXAMPLE DATA" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock x:Name="ExampleName" Foreground="{StaticResource Accent}" FontSize="12" HorizontalAlignment="Right" Margin="0,2,0,0"/></StackPanel></Grid>
          <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LayoutExplanation" Text="One row per ID + grouping value. Each variable has its own column." Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="RowVariablesButton" Grid.Column="1" Content="Choose variables to stack…" Click="RowVariables_Click" Style="{StaticResource Quiet}" Visibility="Collapsed" Margin="0"/><Button x:Name="DyadRolesButton" Grid.Column="1" Content="Dyad roles…" Click="DyadRoles_Click" Style="{StaticResource Quiet}" Visibility="Collapsed" Margin="0"/></Grid>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0"><TextBlock Text="COMBINE FILES" Style="{StaticResource Label}" Margin="0,0,0,3"/><ComboBox x:Name="CombineMode" SelectedIndex="0" SelectionChanged="Combine_Changed"><ComboBoxItem Content="Match IDs and groups"/><ComboBoxItem Content="Stack matching columns"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="IDS TO KEEP" Style="{StaticResource Label}" Margin="0,0,0,3"/><ComboBox x:Name="MatchRule" SelectedIndex="0" SelectionChanged="Combine_Changed"><ComboBoxItem Content="All IDs from every file"/><ComboBoxItem Content="IDs in every file"/><ComboBoxItem Content="IDs in the first file"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="SEARCH ROWS" Style="{StaticResource Label}" Margin="0,0,0,3"/><TextBox x:Name="RowFilter" ToolTip="Search text in any column. Matching rows appear in the preview and export." TextChanged="Filter_Changed" MinHeight="33" Margin="0,3,0,0"/><DockPanel Margin="0,5,0,0"><Button Content="Filter rules…" Click="FilterRules_Click" Style="{StaticResource Quiet}" DockPanel.Dock="Right" Margin="6,0,0,0"/><TextBlock x:Name="FilterSummaryText" Text="No filter rules" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel></StackPanel>
        </Grid>
        <StackPanel Grid.Row="3">
          <Border Background="White" BorderBrush="#DDD3E8" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,10"><DockPanel>
            <Button DockPanel.Dock="Right" Content="Clear sorting" Click="ClearSort_Click" Style="{StaticResource Quiet}" Margin="10,0,0,0" VerticalAlignment="Top"/>
            <Grid DockPanel.Dock="Right" Width="240" Margin="10,0,0,0" VerticalAlignment="Top">
              <TextBox x:Name="SortSearch" ToolTip="Type part of a variable name, then press Enter or pick a match to add it to the sort order" TextChanged="SortSearch_Changed" PreviewKeyDown="SortSearch_KeyDown" GotKeyboardFocus="SortSearch_Focus" PreviewMouseLeftButtonUp="SortSearch_MouseUp" MinHeight="31" Padding="8,4"/>
              <TextBlock x:Name="SortSearchHint" Text="Search variables to sort by…" IsHitTestVisible="False" Foreground="{StaticResource Muted}" FontSize="12" Margin="11,0,0,0" VerticalAlignment="Center"/>
              <Popup x:Name="SortSearchPopup" PlacementTarget="{Binding ElementName=SortSearch}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="360">
                <Border Background="White" BorderBrush="{StaticResource Secondary}" BorderThickness="1" CornerRadius="5" Padding="3">
                  <DockPanel>
                    <TextBlock x:Name="SortSearchSummary" DockPanel.Dock="Bottom" FontSize="10" Foreground="{StaticResource Muted}" Margin="6,4,6,3"/>
                    <ListBox x:Name="SortSearchResults" MaxHeight="300" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="SortSearchResults_Click" PreviewKeyDown="SortSearchResults_KeyDown"/>
                  </DockPanel>
                </Border>
              </Popup>
            </Grid>
            <TextBlock DockPanel.Dock="Left" Text="SORT BY" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold" Margin="0,8,12,0" VerticalAlignment="Top"/>
            <WrapPanel x:Name="SortChips" MinHeight="31"/>
          </DockPanel></Border>
          <Border x:Name="NoticeBorder" Background="#EEE8F5" CornerRadius="5" Padding="11,8" Margin="0,0,0,10"><TextBlock x:Name="Notice" Text="Import CSVs or try the fictional example to begin." Foreground="#5F4775" FontSize="11"/></Border>
        </StackPanel>
        <Border Grid.Row="4" Background="White" BorderBrush="#DDD3E8" BorderThickness="1" CornerRadius="6"><Grid>
          <DataGrid x:Name="Preview" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizing="True" AutoGenerateColumns="False" CanUserReorderColumns="True" CellEditEnding="Preview_CellEditEnding" PreparingCellForEdit="Preview_PreparingCellForEdit" ColumnReordered="Preview_ColumnReordered"/>
          <ScrollViewer x:Name="EmptyState" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center" Padding="16">
            <StackPanel HorizontalAlignment="Center" MaxWidth="410">
              <TextBlock Text="Start with a few files." FontSize="25" FontWeight="SemiBold" TextAlignment="Center"/>
              <TextBlock Text="Keep the columns you want, bring matching records together, and switch between wide and long." Foreground="{StaticResource Muted}" Margin="0,10,0,16" TextAlignment="Center"/>
              <Button Content="Try the fictional study" Style="{StaticResource Primary}" Click="Demo_Click" HorizontalAlignment="Center" Margin="0"/>
              <TextBlock Text="Processed privately on your computer. Nothing is sent or automatically saved." FontSize="11" Foreground="{StaticResource Accent}" TextAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Grid></Border>
        <Grid Grid.Row="5" Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Background="#50179A" CornerRadius="4" Padding="8,4" Margin="0,0,10,0"><TextBlock x:Name="ViewingBadge" Text="Viewing: Long" Foreground="White" FontWeight="SemiBold" FontSize="11"/></Border><TextBlock x:Name="Counts" Foreground="#655174" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="PageText" Foreground="#655174" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="FirstPageButton" Content="«" ToolTip="First rows" Click="FirstPage_Click" Style="{StaticResource Quiet}" Margin="0,0,4,0"/>
            <Button x:Name="PrevPageButton" Content="‹ Previous" ToolTip="Previous rows (Ctrl+Page Up)" Click="PrevPage_Click" Style="{StaticResource Quiet}" Margin="0,0,4,0"/>
            <Button x:Name="NextPageButton" Content="Next ›" ToolTip="Next rows (Ctrl+Page Down)" Click="NextPage_Click" Style="{StaticResource Quiet}" Margin="0,0,4,0"/>
            <Button x:Name="LastPageButton" Content="»" ToolTip="Last rows" Click="LastPage_Click" Style="{StaticResource Quiet}" Margin="0,0,12,0"/>
            <TextBlock Text="Rows shown" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="PageSizeChoice" SelectedIndex="1" SelectionChanged="PageSize_Changed" MinHeight="26" Margin="0" Padding="6,2" ToolTip="How many rows the preview draws at once. Smaller is faster. Sorting, filters and export always use every row."><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/><ComboBoxItem Content="250"/><ComboBoxItem Content="500"/><ComboBoxItem Content="1000"/></ComboBox>
          </StackPanel></Grid>
      </Grid>
    </Grid>
    <!-- The status bar is hidden by request; Status still records the last action for accessibility and debugging. Important messages use the notice bar. -->
    <Border Grid.Row="2" Visibility="Collapsed"><TextBlock x:Name="Status" Text="Ready · no data loaded"/></Border>
  </Grid>
</Window>
